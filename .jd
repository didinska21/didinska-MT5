python -c "from dotenv import dotenv_values; e=dotenv_values('.env'); print('GATEWAY_TOKEN:', 'SET' if e.get('GATEWAY_TOKEN') and 'CHANGE_THIS' not in e.get('GATEWAY_TOKEN') else 'NOT SET'); print('GROQ KEYS:', sum(bool(e.get(f'GROQ_API_KEY_{i:02d}')) for i in range(1,11)), '/ 10'); print('MODEL:', e.get('GROQ_MODEL','NOT SET')); print('BASE URL:', e.get('GROQ_BASE_URL','NOT SET'))"
